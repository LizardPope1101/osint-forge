{
  "schema": 2,
  "plugin_version": "2",
  "id": "nmap",
  "name": "Nmap",
  "description": "Authorized network discovery and service inventory.",
  "category": "infrastructure",
  "homepage": "https://nmap.org/",
  "upstream_license": "LicenseRef-NPSL",
  "upstream_license_url": "https://nmap.org/npsl/",
  "tags": [
    "network",
    "authorized",
    "batch"
  ],
  "commands": [
    "nmap"
  ],
  "supports": [
    "domain",
    "ip"
  ],
  "entities": {
    "accepted": [
      "domain",
      "ip"
    ],
    "emitted": [
      "domain",
      "ip"
    ]
  },
  "batch": true,
  "normalizer": "normalize.py",
  "lifecycle": {
    "install": "install.sh",
    "update": "update.sh",
    "remove": "remove.sh",
    "doctor": "doctor.sh"
  },
  "requires_root": {
    "install": true,
    "update": true,
    "remove": true,
    "doctor": false
  },
  "adapters": {
    "domain": {
      "command": [
        "nmap",
        "-sV",
        "--top-ports",
        "100",
        "-oA",
        "results",
        "{target}"
      ]
    },
    "ip": {
      "command": [
        "nmap",
        "-sV",
        "--top-ports",
        "100",
        "-oA",
        "results",
        "{target}"
      ]
    }
  },
  "notes": "Use only on systems you own or are explicitly authorized to assess."
}
