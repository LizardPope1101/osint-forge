{
  "schema": 1,
  "plugin_version": "2",
  "id": "exiftool",
  "name": "ExifTool",
  "description": "Extract metadata from images and documents.",
  "category": "metadata",
  "homepage": "https://exiftool.org/",
  "upstream_license": "Artistic-1.0-Perl OR GPL-1.0-or-later",
  "upstream_license_url": "https://exiftool.org/",
  "tags": [
    "images",
    "documents",
    "batch"
  ],
  "commands": [
    "exiftool"
  ],
  "supports": [
    "image",
    "file"
  ],
  "batch": true,
  "normalizer": "normalize.py",
  "lifecycle": {
    "install": "install.sh",
    "update": "update.sh",
    "remove": "remove.sh",
    "doctor": "doctor.sh"
  },
  "requires_root": {
    "install": true,
    "update": true,
    "remove": true,
    "doctor": false
  },
  "adapters": {
    "image": {
      "command": [
        "exiftool",
        "-json",
        "-G",
        "-a",
        "-u",
        "{target}"
      ]
    },
    "file": {
      "command": [
        "exiftool",
        "-json",
        "-G",
        "-a",
        "-u",
        "{target}"
      ]
    }
  }
}
